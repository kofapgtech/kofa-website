# Supabase project "kofa-website" — backs the contact page and the home page
# "Connect with us" form. Both values are safe to expose: the publishable key
# can only INSERT into contact_submissions (see supabase/migrations/), never read.
#
# Defaults for this project are compiled into src/lib/supabase.ts, so these are
# only needed to point a build at a different project (e.g. a staging one).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
